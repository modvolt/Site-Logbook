# ============================================================================
# Stavba deployment configuration
# ----------------------------------------------------------------------------
# Root Compose is not a local quick-start. Copy this file only while preparing a
# reviewed production release. The stack starts into HOLD; do not activate the
# API until the post-deployment host observer evidence has been sealed and
# verified. On Coolify, set values in the resource environment UI instead of
# committing a .env file.
# ============================================================================

# --- Immutable production release inputs -----------------------------------
# Root docker-compose.yml is the production runtime contract. Every value below
# is required and must be recorded from an approved release; there are no tag or
# discovery fallbacks. Do not point PRODUCTION_API_IMAGE at the staging
# control-plane image.
PRODUCTION_POSTGRES_IMAGE=
PRODUCTION_API_IMAGE=
PRODUCTION_WEB_IMAGE=
BUILD_SHA=
# Precreate this directory on the production host. It is mounted read-only in
# the API container; do not put secrets or private keys in it.
PRODUCTION_HOST_EVIDENCE_DIR=
# `sha256:` fingerprints of the canonical DER-SPKI key material. These are not
# hashes of the PEM file bytes; publisher and host keys must be distinct.
PRODUCTION_ACTIVATION_PUBLISHER_PUBLIC_KEY_SHA256=
PRODUCTION_ACTIVATION_HOST_PUBLIC_KEY_SHA256=
# Desired/deployed configuration and resolved Compose digests are deliberately
# absent here. Coolify hashes application env values, so expected-digest env
# variables would be self-referential. The signed activation bundle binds the
# authoritative post-deployment observer outputs instead.

# --- PostgreSQL bootstrap/admin --------------------------------------------
# These values initialize/administer PostgreSQL. They are never the API login.
POSTGRES_USER=stavba
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=stavba

# --- PostgreSQL API runtime -------------------------------------------------
# Required production Coolify secret. Generate and retain a unique 32-256
# character [A-Za-z0-9._~-] value outside Git, stdout and shell history. The
# attended credential ceremony sets the same value on site_logbook_runtime;
# never reuse POSTGRES_PASSWORD here.
PRODUCTION_RUNTIME_DATABASE_PASSWORD=

# --- API server -------------------------------------------------------------
# Secret used to sign session cookies. Generate one, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=change-me-session-secret-please

# Max request body size, in MB, for JSON / form payloads (default 50). This is
# the cap for CSV bulk imports and base64 uploads. If you raise it above 100,
# also raise client_max_body_size in artifacts/stavba/nginx.conf. Binary
# photo/document uploads have a separate, higher cap and are not affected.
MAX_REQUEST_BODY_MB=50

# --- Hetzner Object Storage --------------------------------------------------
# Production has no bundled MinIO fallback. Create the bucket and credentials
# in Hetzner, then set the exact location endpoint. The API proxies uploads, so
# browsers never connect to the bucket and no browser CORS policy is required.
# Valid locations are fsn1, nbg1 and hel1. The exact pre-migration backup uses
# client-side MVE1 encryption and requires durable object VersionId evidence.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Web frontend -----------------------------------------------------------
# Host port the app is served on.
WEB_PORT=8080

# --- Database backups — optional but strongly recommended -------------------
# Automated pg_dump backups are uploaded to object storage (same bucket as
# uploads, under the "backups/" prefix). Backups are skipped automatically if
# object storage is not configured. Requires `pg_dump` (postgresql-client) on
# the API container — already included in artifacts/api-server/Dockerfile.
#
# Set to "false" to disable scheduled backups entirely (manual backups from the
# admin UI still work). Defaults to enabled when object storage is configured.
BACKUP_ENABLED=true
# How often the scheduled backup runs, in hours (default 24).
BACKUP_INTERVAL_HOURS=24
# How many of the most recent successful backups to keep; older ones are pruned
# from object storage and the backup log (default 14).
BACKUP_RETENTION=14
# A running attempt is never reconciled while another replica holds the backup
# execution lock. After a crash releases that lock, rows older than this fence
# are marked failed before a new attempt may start (default 24, clamp 1..168).
BACKUP_STALE_RUNNING_HOURS=24
# Path to the pg_dump binary, if not on PATH (default: "pg_dump").
# PG_DUMP_PATH=/usr/bin/pg_dump

# --- Operational SLI thresholds (R15-A) --------------------------------------
# These values only evaluate redacted DB aggregates and write transition events
# to the structured server log. No external alert transport is enabled by them.
OPERATIONAL_QUEUE_WARNING_AGE_MINUTES=15
OPERATIONAL_QUEUE_CRITICAL_AGE_MINUTES=60
OPERATIONAL_FAILED_DEPTH_CRITICAL=5
OPERATIONAL_BACKUP_WARNING_AGE_HOURS=26
OPERATIONAL_BACKUP_CRITICAL_AGE_HOURS=48
OPERATIONAL_RESTORE_WARNING_AGE_DAYS=8
OPERATIONAL_RESTORE_CRITICAL_AGE_DAYS=14
OPERATIONAL_SECURITY_WARNING_EVENTS_15M=10
OPERATIONAL_SECURITY_CRITICAL_EVENTS_15M=25

# Optional outbound operational-alert transport. Disabled is the safe default;
# URL/token values alone never activate network delivery. When enabled, startup
# fails closed unless the target is a public HTTPS URL and the token is valid.
OPERATIONAL_ALERT_TRANSPORT=disabled
OPERATIONAL_ALERT_WEBHOOK_URL=
# Exact comma-separated hostnames allowed as webhook destinations. Required
# when enabled; this must include the hostname from the URL above.
OPERATIONAL_ALERT_WEBHOOK_ALLOWED_HOSTS=
OPERATIONAL_ALERT_WEBHOOK_BEARER_TOKEN=
OPERATIONAL_ALERT_WEBHOOK_TIMEOUT_MS=4000
OPERATIONAL_ALERT_WEBHOOK_COOLDOWN_SECONDS=900

# The independent receiver is deployed separately from this application. Its
# RECEIVER_BEARER_TOKEN must equal the webhook token above, but is created only
# in the receiver/app secret managers (never committed or generated here).

# --- Email (SMTP) — optional ------------------------------------------------
# Leave SMTP_HOST empty to disable outbound email (PDF job sheets).
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); leave empty to auto-detect from the port.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- AI document extraction (OpenAI) — optional -----------------------------
# When configured AND enabled, uploaded cost-document PDFs/photos are extracted
# by OpenAI to PREFILL the header + lines. The AI result is NEVER auto-approved
# — it is saved as a "needs review" suggestion for an admin to confirm. The app
# works fully without OpenAI (documents are then routed to manual review).
#
# Self-hosted prod uses your OWN OpenAI API key (the Replit AI proxy is not
# available off-Replit). The key is read from the environment only; it is never
# stored in the database or logged. Leave OPENAI_API_KEY empty to disable.
OPENAI_API_KEY=
# Master switch — extraction only runs when this is exactly "true" (default off).
OPENAI_DOCUMENT_EXTRACTION_ENABLED=false
# Vision/file-capable model used for extraction (default "gpt-4o").
OPENAI_DOCUMENT_MODEL=gpt-4o
# Max input file size sent to OpenAI, in MB (default 32). OpenAI itself caps
# inputs (~32 MB per PDF, ~20 MB per image); going higher has no real effect.
OPENAI_MAX_FILE_MB=32
# Per-request timeout to OpenAI, in milliseconds (default 60000).
OPENAI_REQUEST_TIMEOUT_MS=60000

# --- Gmail / Google Workspace import — optional -----------------------------
# When fully configured, an admin can connect a Google account (read-only Gmail)
# and import supplier cost-document attachments (PDFs/photos) straight into
# Fakturace as "needs review" documents. The feature is OFF by default and the
# app works fully without it (documents can always be uploaded manually).
#
# Create an OAuth 2.0 "Web application" client in Google Cloud Console, enable
# the Gmail API, and set the authorized redirect URI to GOOGLE_REDIRECT_URI
# below (it must point at /api/billing/email-import/callback on your domain).
# Leave GOOGLE_CLIENT_ID empty to disable the feature entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full callback URL, e.g. https://your-domain.tld/api/billing/email-import/callback
GOOGLE_REDIRECT_URI=
# Versioned application keyring. Values must be canonical base64 for exactly
# 32 random bytes; key IDs contain only letters, digits, dot, underscore, dash.
# Example shape: {"2026-08":"<output of: openssl rand -base64 32>"}
SECRET_ENCRYPTION_KEYRING=
SECRET_ENCRYPTION_ACTIVE_KEY_ID=
# Dedicated keyring for encrypted database backups. Never reuse application keys.
BACKUP_ENCRYPTION_KEYRING=
BACKUP_ENCRYPTION_ACTIVE_KEY_ID=
# Legacy read-only key for Gmail/QR values written before migration 0099. Keep
# it through verified backfill, then remove it; new writes never use this key.
TOKEN_ENCRYPTION_KEY=

# Canonical public origin embedded in switchboard QR labels.
PUBLIC_APP_URL=https://modvoltapp.cz
# Required by the production API image. Set only the exact nginx/Coolify proxy
# IPs or dedicated bounded network CIDRs, comma-separated (never 0.0.0.0/0).
API_TRUSTED_PROXY_CIDRS=

# Authenticated external accounts stay dark until the dedicated rollout gate
# is accepted. Only the exact lowercase value "true" enables login/activation.
EXTERNAL_ACCOUNTS_ENABLED=false
# Public bearer credentials are one-time and expire. Values are whole days;
# invalid values fall back to these defaults and the application clamps 1..365.
JOB_SIGNATURE_EXPIRY_DAYS=7
PPE_SIGNATURE_EXPIRY_DAYS=30
PPE_CONFIRM_EXPIRY_DAYS=30
QUOTE_SHARE_EXPIRY_DAYS=30
# Space-separated public hostnames accepted by the web edge. Keep the bare
# hostname(s) only; localhost/127.0.0.1 are added internally for healthchecks.
NGINX_SERVER_NAME=modvoltapp.cz
# Optional separate salt for irreversible IP hashes in QR access audit records.
QR_AUDIT_SALT=

# Optional defaults applied when no labels are configured in the admin UI.
# Default Gmail label(s) to pull from (comma-separated). Empty = whole mailbox.
GMAIL_LABEL=
# Extra Gmail search query appended to the label filter (e.g. "has:attachment").
GMAIL_QUERY=
# Max messages fetched per sync (default 50).
GMAIL_MAX_MESSAGES=50
# "true" to label processed emails (Stavba/Importováno) so they aren't re-fetched.
GMAIL_LABEL_AFTER_IMPORT=false
# Open work sessions longer than this are preserved and marked for review.
WORK_SESSION_REVIEW_HOURS=12

# Local OCR for SchrackNorm DBO PDFs. Production should provide ces+eng
# traineddata in OCR_LANG_PATH so first use never depends on an external fetch.
OCR_LANG_PATH=
OCR_CACHE_PATH=/tmp/tesseract-cache
