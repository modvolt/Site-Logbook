# Independent receiver only. Do not reuse an application/session/backup key.
RECEIVER_BEARER_TOKEN=
RECEIVER_BUILD_SHA=
RECEIVER_STATE_DIR=/var/lib/operational-alert-receiver
RECEIVER_BIND_HOST=0.0.0.0
# Required for a non-loopback bind. TLS must terminate at a trusted proxy.
RECEIVER_TRUSTED_TLS_PROXY=true
PORT=8080

# Public staging application readiness endpoint monitored outside its process.
DEAD_MAN_TARGET_URL=https://staging.example.invalid/healthz
DEAD_MAN_INTERVAL_SECONDS=60
DEAD_MAN_TIMEOUT_MS=5000
DEAD_MAN_FAILURE_THRESHOLD=3
