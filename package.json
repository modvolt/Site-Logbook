{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/assert-pnpm-install.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "codegen:api-route-manifest": "node ./scripts/generate-api-route-manifest.mjs",
    "gate:release": "node ./scripts/run-hermetic-gate.mjs",
    "gate:staging-config": "node ./scripts/staging-release-guard.cjs",
    "gate:staging-evidence": "node ./scripts/check-staging-release-evidence.mjs",
    "gate:staging-runtime": "node ./scripts/check-staging-runtime-contract.mjs",
    "gate:quality": "pnpm run lint && pnpm run check:peers && pnpm run audit:dependencies",
    "lint": "eslint . --max-warnings=0",
    "check:peers": "pnpm peers check",
    "audit:dependencies": "pnpm audit --audit-level=moderate",
    "test": "node ./scripts/run-hermetic-gate.mjs --tests-only",
    "test:staging-contract": "node --test scripts/test/staging-release-guard.test.mjs scripts/test/staging-release-evidence.test.mjs scripts/test/staging-runtime-contract.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:e2e:staging": "tsc -p e2e/tsconfig.staging.json",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:staging": "playwright test --config=e2e/playwright.staging.config.ts"
  },
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.65.0",
    "typescript": "~5.9.3"
  }
}
