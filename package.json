{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/assert-pnpm-install.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "codegen:api-route-manifest": "node ./scripts/generate-api-route-manifest.mjs",
    "gate:release": "node ./scripts/run-hermetic-gate.mjs",
    "gate:staging-config": "node ./scripts/staging-release-guard.cjs",
    "gate:staging-evidence": "node ./scripts/check-staging-release-evidence.mjs",
    "gate:staging-runtime": "node ./scripts/check-staging-runtime-contract.mjs",
    "prepare:staging-workflow-harness": "node ./scripts/prepare-workflow-execution-harness.mjs",
    "recovery:ceremony": "node ./scripts/recovery-ceremony.mjs",
    "gate:quality": "pnpm run lint && pnpm run check:peers && pnpm run audit:dependencies",
    "lint": "eslint . --max-warnings=0",
    "check:peers": "pnpm peers check",
    "audit:dependencies": "pnpm audit --audit-level=moderate",
    "test": "node ./scripts/run-hermetic-gate.mjs --tests-only",
    "test:recovery-ceremony": "node --test scripts/test/recovery-ceremony.test.mjs",
    "test:staging-contract": "node --test scripts/test/staging-release-guard.test.mjs scripts/test/staging-release-evidence.test.mjs scripts/test/staging-runtime-contract.test.mjs scripts/test/staging-workflow-execution.test.mjs scripts/test/operational-alert-receiver.test.mjs scripts/test/staging-operational-alert-drill.test.mjs",
    "test:staging-workflow-execution": "node --test scripts/test/staging-workflow-execution.test.mjs",
    "test:r14-full-stack-contract": "node --test scripts/test/r14-full-stack-contract.test.mjs",
    "test:operational-alert-receiver": "node --test scripts/test/operational-alert-receiver.test.mjs",
    "test:staging-operational-alert": "node --test scripts/test/operational-alert-receiver.test.mjs scripts/test/staging-operational-alert-drill.test.mjs",
    "drill:staging-operational-alert": "node scripts/staging-operational-alert-drill.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:e2e:staging": "tsc -p e2e/tsconfig.staging.json",
    "typecheck:e2e:pwa-isolation": "tsc -p e2e/tsconfig.pwa-isolation.json",
    "typecheck:e2e:r14-full-stack": "tsc -p e2e/tsconfig.r14-full-stack.json",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:pwa-isolation": "node ./scripts/run-pwa-isolation-gate.mjs",
    "test:e2e:r14-full-stack": "node ./scripts/run-r14-full-stack-gate.mjs",
    "test:e2e:staging": "playwright test --config=e2e/playwright.staging.config.ts"
  },
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@scure/bip39": "2.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "yaml": "2.8.4"
  }
}
