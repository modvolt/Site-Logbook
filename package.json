{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/assert-pnpm-install.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "codegen:api-route-manifest": "node ./scripts/generate-api-route-manifest.mjs",
    "gate:release": "node ./scripts/run-hermetic-gate.mjs",
    "recovery:ceremony": "node ./scripts/recovery-ceremony.mjs",
    "gate:quality": "pnpm run lint && pnpm run check:peers && pnpm run audit:dependencies",
    "lint": "eslint . --max-warnings=0",
    "check:peers": "pnpm peers check",
    "audit:dependencies": "pnpm audit --audit-level=moderate",
    "test": "node ./scripts/run-hermetic-gate.mjs --tests-only",
    "test:recovery-ceremony": "node --test scripts/test/recovery-ceremony.test.mjs",
    "test:production-host-evidence": "node --test scripts/test/production-host-evidence.test.mjs && pnpm --filter @workspace/api-server exec vitest run --config vitest.unit.config.ts test/production-evidence-runner.contract.test.ts",
    "test:production-host-operator-packaging": "node --test scripts/test/production-host-operator-packaging.test.mjs",
    "test:production-signing-custody": "node --test scripts/test/production-pinned-key-contract.test.mjs scripts/test/production-signing-custody.test.mjs",
    "test:production-exact-0096-backup-contract": "node --test scripts/test/production-exact-0096-backup-contract.test.mjs scripts/test/production-exact-0096-backup-host-adapter.test.mjs scripts/test/production-exact-0096-backup-signature.test.mjs scripts/test/production-exact-0096-disposable-restore-lifecycle.test.mjs scripts/test/production-exact-0096-disposable-restore-rehearsal.test.mjs",
    "test:production-exact-0096-host-runner": "node --test scripts/test/production-exact-0096-host-runner.test.mjs",
    "production:exact-0096-backup": "node scripts/production-evidence/run-production-exact-0096-backup.mjs",
    "rehearsal:production-exact-0096-restore": "node scripts/production-exact-0096-disposable-restore-rehearsal.mjs",
    "test:production-migration-control-plane": "node --test scripts/test/production-migration-control-plane.test.mjs scripts/test/production-migration-adapter.test.mjs",
    "test:production-migration-runner": "node --test scripts/test/production-migration-runner.test.mjs scripts/test/production-migration-runtime-authority.test.mjs scripts/test/production-migration-role-authority.test.mjs",
    "test:production-invoice-0108-runner": "node --test scripts/test/production-invoice-0108-runner.test.mjs",
    "test:production-exact-0107-backup-authority": "node --test scripts/test/production-exact-0107-backup-authority.test.mjs",
    "test:production-invoice-0108:pg": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-invoice-0108.pg.test.mjs",
    "test:production-invoice-0108-cli": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-invoice-0108-cli.test.mjs",
    "test:production-invoice-0108-activation-evidence": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-invoice-0108-activation-evidence.test.mjs",
    "test:production-role-0108-contract": "node --test scripts/test/production-role-separation-0108-contract.test.mjs",
    "test:production-migration-runner:pg16": "node --test scripts/test/production-migration-runner.pg16.test.mjs",
    "test:production-migration-role-bootstrap:pg16": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-migration-role-bootstrap.pg16.test.ts",
    "test:production-runtime-db-credential-contract": "pnpm --filter @workspace/api-server run test:production-runtime-db-credential-contract",
    "test:production-activation-hold": "pnpm --filter @workspace/api-server run test:production-activation-hold",
    "test:production-activation-bundle": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-activation-bundle.test.mjs",
    "test:production-activation-0108-bundle": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-activation-0108-bundle.test.mjs",
    "test:production-activation-0108-contract": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-activation-0108-contract.test.mjs",
    "test:production-runtime-db-credential:pg16": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-runtime-db-credential-cutover.pg16.test.ts",
    "production:migration": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs scripts/production-evidence/run-production-migration.mjs",
    "production:migration:plan": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs artifacts/api-server/src/standard-production-migration.ts plan",
    "production:migration:apply": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs artifacts/api-server/src/standard-production-migration.ts apply",
    "production:invoice-0108": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs scripts/production-evidence/run-production-invoice-0108.mjs",
    "production:invoice-0108-activation-evidence": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs scripts/production-evidence/run-production-invoice-0108-activation-evidence.mjs",
    "production:host-evidence": "node scripts/production-evidence/run-production-host-evidence.mjs",
    "production:activation-bundle": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs scripts/production-evidence/run-production-activation-bundle.mjs",
    "production:activation-0108-bundle": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs scripts/production-evidence/run-production-activation-0108-bundle.mjs",
    "test:r14-full-stack-contract": "node --test scripts/test/r14-full-stack-contract.test.mjs",
    "test:operational-alert-receiver": "node --test scripts/test/operational-alert-receiver.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:e2e:pwa-isolation": "tsc -p e2e/tsconfig.pwa-isolation.json",
    "typecheck:e2e:r14-full-stack": "tsc -p e2e/tsconfig.r14-full-stack.json",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:pwa-isolation": "node ./scripts/run-pwa-isolation-gate.mjs",
    "test:e2e:r14-full-stack": "node ./scripts/run-r14-full-stack-gate.mjs",
  },
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@scure/bip39": "2.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "yaml": "2.8.4"
  }
}
