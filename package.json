{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/assert-pnpm-install.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "codegen:api-route-manifest": "node ./scripts/generate-api-route-manifest.mjs",
    "gate:release": "node ./scripts/run-hermetic-gate.mjs",
    "gate:staging-config": "node ./scripts/staging-release-guard.cjs",
    "gate:staging-evidence": "node ./scripts/check-staging-release-evidence.mjs",
    "gate:staging-image-manifest": "node ./scripts/verify-staging-image-manifest.mjs",
    "gate:staging-predecessor-image": "node ./scripts/verify-staging-predecessor-image.mjs",
    "gate:staging-provisioning": "node ./scripts/check-staging-provisioning.mjs",
    "gate:staging-deployment-binding": "node ./scripts/check-staging-deployment-binding.mjs",
    "gate:staging-baseline-0104-binding": "node ./scripts/check-staging-baseline-0104-binding.mjs",
    "gate:staging-exact-0104-recovery-binding": "node ./scripts/check-staging-exact-0104-recovery-binding.mjs",
    "gate:staging-runtime": "node ./scripts/check-staging-runtime-contract.mjs",
    "staging:apply-0104-baseline": "node ./scripts/run-staging-baseline-0104.mjs",
    "staging:create-exact-0104-backup": "node ./scripts/run-staging-exact-0104-backup.mjs",
    "staging:verify-exact-0104-recovery": "node ./scripts/run-staging-exact-0104-recovery.mjs",
    "staging:apply-0105-transition": "node ./scripts/run-staging-schema-transition.mjs",
    "staging:create-exact-0105-accounting-backup": "node ./scripts/run-staging-exact-0105-backup.mjs",
    "gate:staging-accounting-0106-binding": "node ./scripts/check-staging-accounting-0106-binding.mjs",
    "staging:apply-accounting-0106-transition": "node ./scripts/run-staging-accounting-0106-transition.mjs",
    "gate:staging-accounting-0106-execution": "node ./scripts/verify-staging-accounting-0106-execution.mjs",
    "staging:create-exact-0106-audit-backup": "node ./scripts/run-staging-exact-0106-audit-backup.mjs",
    "gate:staging-audit-0107-binding": "node ./scripts/check-staging-audit-0107-binding.mjs",
    "staging:apply-audit-0107-transition": "node ./scripts/run-staging-audit-0107-transition.mjs",
    "gate:staging-audit-0107-execution": "node ./scripts/verify-staging-audit-0107-execution.mjs",
    "prepare:staging-workflow-harness": "node ./scripts/prepare-workflow-execution-harness.mjs",
    "recovery:ceremony": "node ./scripts/recovery-ceremony.mjs",
    "gate:quality": "pnpm run lint && pnpm run check:peers && pnpm run audit:dependencies",
    "lint": "eslint . --max-warnings=0",
    "check:peers": "pnpm peers check",
    "audit:dependencies": "pnpm audit --audit-level=moderate",
    "test": "node ./scripts/run-hermetic-gate.mjs --tests-only",
    "test:recovery-ceremony": "node --test scripts/test/recovery-ceremony.test.mjs",
    "test:staging-contract": "node --test scripts/test/staging-release-guard.test.mjs scripts/test/staging-release-evidence.test.mjs scripts/test/staging-deployment-binding.test.mjs scripts/test/staging-baseline-binding.test.mjs scripts/test/staging-baseline-runner.test.mjs scripts/test/staging-exact-0104-backup-runner.test.mjs scripts/test/staging-exact-0104-recovery-binding.test.mjs scripts/test/staging-exact-0104-recovery-runner.test.mjs scripts/test/staging-schema-transition-runner.test.mjs scripts/test/staging-exact-0105-backup-runner.test.mjs scripts/test/staging-accounting-0106-binding.test.mjs scripts/test/staging-accounting-0106-transition-runner.test.mjs scripts/test/staging-runtime-contract.test.mjs scripts/test/staging-predecessor-image.test.mjs scripts/test/staging-proxy-preflight.test.mjs scripts/test/staging-workflow-execution.test.mjs scripts/test/operational-alert-receiver.test.mjs scripts/test/staging-operational-alert-drill.test.mjs",
    "test:staging-audit-0107-contract": "node --test scripts/test/staging-exact-0106-audit-backup-runner.test.mjs scripts/test/staging-audit-0107-binding.test.mjs scripts/test/staging-audit-0107-transition-runner.test.mjs",
    "test:production-host-evidence": "node --test scripts/test/production-host-evidence.test.mjs && pnpm --filter @workspace/api-server exec vitest run --config vitest.unit.config.ts test/production-evidence-runner.contract.test.ts",
    "test:production-signing-custody": "node --test scripts/test/production-pinned-key-contract.test.mjs scripts/test/production-signing-custody.test.mjs",
    "test:production-exact-0096-backup-contract": "node --test scripts/test/production-exact-0096-backup-contract.test.mjs scripts/test/production-exact-0096-backup-host-adapter.test.mjs scripts/test/production-exact-0096-backup-signature.test.mjs scripts/test/production-exact-0096-disposable-restore-lifecycle.test.mjs scripts/test/production-exact-0096-disposable-restore-rehearsal.test.mjs",
    "test:production-exact-0096-host-runner": "node --test scripts/test/production-exact-0096-host-runner.test.mjs",
    "production:exact-0096-backup": "node scripts/production-evidence/run-production-exact-0096-backup.mjs",
    "rehearsal:production-exact-0096-restore": "node scripts/production-exact-0096-disposable-restore-rehearsal.mjs",
    "test:production-migration-control-plane": "node --test scripts/test/production-migration-control-plane.test.mjs scripts/test/production-migration-adapter.test.mjs",
    "test:production-migration-runner": "node --test scripts/test/production-migration-runner.test.mjs scripts/test/production-migration-runtime-authority.test.mjs scripts/test/production-migration-role-authority.test.mjs",
    "test:production-migration-runner:pg16": "node --test scripts/test/production-migration-runner.pg16.test.mjs",
    "test:production-migration-role-bootstrap:pg16": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs --test scripts/test/production-migration-role-bootstrap.pg16.test.ts",
    "production:migration": "node --import ./lib/db/node_modules/tsx/dist/loader.mjs scripts/production-evidence/run-production-migration.mjs",
    "production:host-evidence": "node scripts/production-evidence/run-production-host-evidence.mjs",
    "test:staging-workflow-execution": "node --test scripts/test/staging-workflow-execution.test.mjs",
    "test:r14-full-stack-contract": "node --test scripts/test/r14-full-stack-contract.test.mjs",
    "test:operational-alert-receiver": "node --test scripts/test/operational-alert-receiver.test.mjs",
    "test:staging-operational-alert": "node --test scripts/test/operational-alert-receiver.test.mjs scripts/test/staging-operational-alert-drill.test.mjs",
    "drill:staging-operational-alert": "node scripts/staging-operational-alert-drill.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "typecheck:e2e:staging": "tsc -p e2e/tsconfig.staging.json",
    "typecheck:e2e:pwa-isolation": "tsc -p e2e/tsconfig.pwa-isolation.json",
    "typecheck:e2e:r14-full-stack": "tsc -p e2e/tsconfig.r14-full-stack.json",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:pwa-isolation": "node ./scripts/run-pwa-isolation-gate.mjs",
    "test:e2e:r14-full-stack": "node ./scripts/run-r14-full-stack-gate.mjs",
    "test:e2e:staging": "playwright test --config=e2e/playwright.staging.config.ts"
  },
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@scure/bip39": "2.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "yaml": "2.8.4"
  }
}
