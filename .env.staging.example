# Secret-free input contract for docker-compose.staging.yml.
#
# Keep every value in a NEW Coolify staging resource. Never copy production
# values and never commit a populated .env.staging file. Empty secret values
# intentionally make `docker compose config` fail closed.

STAGING_COMPOSE_PROJECT_NAME=site-logbook-staging
STAGING_ENVIRONMENT_ID=site-logbook-staging
# Start with inspect. Use apply-0105 only for the separately approved transition,
# then steady-0105 for routine restarts after exact 0105 is proven.
STAGING_SCHEMA_ACTION=inspect

# Must be a separate HTTPS origin outside modvoltapp.cz and its subdomains.
STAGING_PUBLIC_APP_URL=
# Bare hostname only; must exactly match STAGING_PUBLIC_APP_URL.
STAGING_NGINX_SERVER_NAME=
# Exact comma-separated nginx/Coolify proxy IPs or bounded CIDRs visible to the
# API. Read these from the isolated staging topology; never use /0 or aliases.
STAGING_API_TRUSTED_PROXY_CIDRS=
# Keep false during schema/code dark rollout. Enabling is a separate decision.
STAGING_EXTERNAL_ACCOUNTS_ENABLED=false

# Exact lowercase 40-character commit SHA deployed to staging.
STAGING_BUILD_SHA=
# Exact sourceSha copied from the approved immutable staging image manifest.
# It must match the API image's baked BUILD_SHA and STAGING_BUILD_SHA.
STAGING_IMAGE_MANIFEST_SOURCE_SHA=
# Exact raw staging-images.json bytes encoded as single-line base64. Generate
# this and every digest below only with gate:staging-deployment-binding.
STAGING_IMAGE_MANIFEST_B64=
# Separately approved SHA-256 of the raw image manifest bytes (64 lowercase hex).
STAGING_IMAGE_MANIFEST_SHA256=
# SHA-256 of the validated observed Coolify provisioning manifest.
STAGING_PROVISIONING_MANIFEST_SHA256=
# Canonical secret-free input hash for the selected schema action. Transition
# and steady-0105 deliberately have different hashes.
STAGING_DEPLOYMENT_INPUTS_SHA256=
# Must stay empty in inspect and steady-0105 modes. Set the exact phrase only
# together with STAGING_SCHEMA_ACTION=apply-0105 during the approved transition.
STAGING_EXTERNAL_SCHEMA_PREFLIGHT_CONFIRMATION=
# Numeric id of the newest backup_log row restored into staging. The same row
# must be successful, encrypted and restore-tested within this bounded window.
# Clear both values after switching to steady-0105; routine restarts deliberately
# do not depend on historical transition evidence.
STAGING_BACKUP_EVIDENCE_ID=
STAGING_BACKUP_RESTORE_MAX_AGE_HOURS=24

# Full immutable references emitted by the separately approved staging image
# publication workflow. Each must use repository@sha256:<64 lowercase hex>.
STAGING_PREFLIGHT_IMAGE=
STAGING_MAILPIT_IMAGE=
STAGING_API_IMAGE=
STAGING_WEB_IMAGE=
STAGING_ALERT_RECEIVER_IMAGE=

# Generate each independently with: openssl rand -hex 32
STAGING_POSTGRES_PASSWORD=
STAGING_SESSION_SECRET=

# Public TLS endpoint assigned only to the alert-receiver service. The URL path
# must be exactly /v1/operational-alerts and the bare hostname must match.
STAGING_OPERATIONAL_ALERT_RECEIVER_URL=
STAGING_OPERATIONAL_ALERT_RECEIVER_HOST=
# Generate independently as 32 random base64url bytes. Never reuse an app,
# session, backup, recovery or production secret.
STAGING_OPERATIONAL_ALERT_BEARER_TOKEN=

# Use a NEW least-privilege credential and bucket dedicated to staging. These
# are provider-issued values; never copy the production S3 credential or bucket.
STAGING_S3_ENDPOINT=
STAGING_S3_REGION=
STAGING_S3_BUCKET=
STAGING_S3_ACCESS_KEY_ID=
STAGING_S3_SECRET_ACCESS_KEY=
STAGING_S3_FORCE_PATH_STYLE=false

# Generate each key independently with: openssl rand -base64 32
# JSON shape: {"staging-app-2026-08":"<base64>"}
STAGING_SECRET_ENCRYPTION_KEYRING=
STAGING_SECRET_ENCRYPTION_ACTIVE_KEY_ID=staging-app-2026-08
# JSON shape: {"staging-backup-2026-08":"<different-base64>"}
STAGING_BACKUP_ENCRYPTION_KEYRING=
STAGING_BACKUP_ENCRYPTION_ACTIVE_KEY_ID=staging-backup-2026-08
