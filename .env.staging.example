# Secret-free input contract for docker-compose.staging.yml.
#
# Keep every value in a NEW Coolify staging resource. Never copy production
# values and never commit a populated .env.staging file. Empty secret values
# intentionally make `docker compose config` fail closed.

STAGING_COMPOSE_PROJECT_NAME=site-logbook-staging
STAGING_ENVIRONMENT_ID=site-logbook-staging

# Must be a separate HTTPS origin outside modvoltapp.cz and its subdomains.
STAGING_PUBLIC_APP_URL=
# Bare hostname only; must exactly match STAGING_PUBLIC_APP_URL.
STAGING_NGINX_SERVER_NAME=

# Exact lowercase 40-character commit SHA deployed to staging.
STAGING_BUILD_SHA=

# Generate each independently with: openssl rand -hex 32
STAGING_POSTGRES_PASSWORD=
STAGING_SESSION_SECRET=

# Use a NEW least-privilege credential and bucket dedicated to staging. These
# are provider-issued values; never copy the production S3 credential or bucket.
STAGING_S3_ENDPOINT=
STAGING_S3_REGION=
STAGING_S3_BUCKET=
STAGING_S3_ACCESS_KEY_ID=
STAGING_S3_SECRET_ACCESS_KEY=
STAGING_S3_FORCE_PATH_STYLE=false

# Generate each key independently with: openssl rand -base64 32
# JSON shape: {"staging-app-2026-08":"<base64>"}
STAGING_SECRET_ENCRYPTION_KEYRING=
STAGING_SECRET_ENCRYPTION_ACTIVE_KEY_ID=staging-app-2026-08
# JSON shape: {"staging-backup-2026-08":"<different-base64>"}
STAGING_BACKUP_ENCRYPTION_KEYRING=
STAGING_BACKUP_ENCRYPTION_ACTIVE_KEY_ID=staging-backup-2026-08
